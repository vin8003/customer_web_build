{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/orders/layout,_N_T_/orders/detail/layout,_N_T_/orders/detail/page,_N_T_/orders/detail"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/orders/detail/__PAGE__",
    "/orders/detail",
    "/orders",
    "/_index",
    "/_head"
  ]
}
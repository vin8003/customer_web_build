{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/orders/layout,_N_T_/orders/chat/layout,_N_T_/orders/chat/page,_N_T_/orders/chat"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/orders/chat/__PAGE__",
    "/orders/chat",
    "/orders",
    "/_index",
    "/_head"
  ]
}
{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/retailers/layout,_N_T_/retailers/page,_N_T_/retailers"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/retailers/__PAGE__",
    "/retailers",
    "/_index",
    "/_head"
  ]
}